# Нусха бардоред: cp deploy/env.production.example .env
# Баъд ин файлро (.env, дар решаи репо) пур кунед. Ин файл ба git намеравад
# (.gitignore аллакай .env-ро истисно кардааст).

# --- Портҳои локалӣ (танҳо 127.0.0.1, аз берун дастрас нест) ---
API_PORT=5100
DB_PORT=5435

# --- База (контейнери алоҳида, аз NIZOM CRM ҷудо) ---
POSTGRES_DB=office
POSTGRES_USER=office
POSTGRES_PASSWORD=<ЗАМИНАИ_ХОЛӢ>

# --- JWT (генератсия кунед: openssl rand -base64 48) ---
JWT_KEY=<ЗАМИНАИ_ХОЛӢ>
# Калиди ДИГАР барои токени Customer (мизози беруна, /api/public/auth) — қасдан аз JWT_KEY
# фарқ мекунад, то токени мизоз аз рӯи имзо ҳам ба system-и дохилӣ мувофиқ наояд.
JWT_CUSTOMER_KEY=<ЗАМИНАИ_ХОЛӢ>

# --- Пароли Owner-и аввалин (танҳо як маротиба, ҳангоми сохтани DB истифода мешавад) ---
SEED_OWNER_PASSWORD=<ЗАМИНАИ_ХОЛӢ>

# --- Resend (коди тасдиқи email-и /api/public/auth) — ихтиёрӣ: холӣ монад, коди тасдиқ
# ба log мебарояд (LoggingEmailSender), на ба email-и воқеӣ. resend.com → API key. ---
RESEND_API_KEY=<ЗАМИНАИ_ХОЛӢ>
RESEND_FROM_ADDRESS=<ЗАМИНАИ_ХОЛӢ>

# --- Google/Apple Sign-In (/api/public/auth/google, /apple) — ихтиёрӣ: холӣ монад, ин ду
# endpoint тамоман сабт намешаванд (на хато — 404), сабти ном/вуруд бо email+parol бетаъсир
# мемонад. Client ID-и ҳарду ба frontend (VITE_GOOGLE_CLIENT_ID/VITE_APPLE_CLIENT_ID) низ лозим. ---
# Google Cloud Console → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=<ЗАМИНАИ_ХОЛӢ>
# Apple Developer (ҳисоби пулакӣ лозим) → Services ID; домен ва redirect URI-ро дар он ҷо
# бояд бо файли domain-association тасдиқ кард
APPLE_CLIENT_ID=<ЗАМИНАИ_ХОЛӢ>

# --- OsonSMS ---
SMS_LOGIN=<ЗАМИНАИ_ХОЛӢ>
SMS_HASH=<ЗАМИНАИ_ХОЛӢ>
SMS_SENDER=<ЗАМИНАИ_ХОЛӢ>
SMS_SERVER_URL=<ЗАМИНАИ_ХОЛӢ>

# --- Meta (App Secret аз Meta dashboard; Verify Token худатон месозед) ---
WEBHOOKS_APP_SECRET=<ЗАМИНАИ_ХОЛӢ>
WEBHOOKS_VERIFY_TOKEN=<ЗАМИНАИ_ХОЛӢ>

# --- Meta OAuth (пайвасти канал тавассути "Login with Meta") ---
# Facebook Login for Business — app-и асосии Meta
META_FACEBOOK_APP_ID=<ЗАМИНАИ_ХОЛӢ>
META_FACEBOOK_APP_SECRET=<ЗАМИНАИ_ХОЛӢ>
# Instagram API with Instagram Login — app-и АЛОҲИДА (ID/Secret аз app-и асосӣ фарқ мекунад)
META_INSTAGRAM_APP_ID=<ЗАМИНАИ_ХОЛӢ>
META_INSTAGRAM_APP_SECRET=<ЗАМИНАИ_ХОЛӢ>
