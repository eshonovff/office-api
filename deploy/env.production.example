# Нусха бардоред: cp deploy/env.production.example .env
# Баъд ин файлро (.env, дар решаи репо) пур кунед. Ин файл ба git намеравад
# (.gitignore аллакай .env-ро истисно кардааст).

# --- Портҳои локалӣ (танҳо 127.0.0.1, аз берун дастрас нест) ---
API_PORT=5100
DB_PORT=5435

# --- База (контейнери алоҳида, аз NIZOM CRM ҷудо) ---
POSTGRES_DB=office
POSTGRES_USER=office
POSTGRES_PASSWORD=<ЗАМИНАИ_ХОЛӢ>

# --- JWT (генератсия кунед: openssl rand -base64 48) ---
JWT_KEY=<ЗАМИНАИ_ХОЛӢ>

# --- Пароли Owner-и аввалин (танҳо як маротиба, ҳангоми сохтани DB истифода мешавад) ---
SEED_OWNER_PASSWORD=<ЗАМИНАИ_ХОЛӢ>

# --- OsonSMS ---
SMS_LOGIN=<ЗАМИНАИ_ХОЛӢ>
SMS_HASH=<ЗАМИНАИ_ХОЛӢ>
SMS_SENDER=<ЗАМИНАИ_ХОЛӢ>
SMS_SERVER_URL=<ЗАМИНАИ_ХОЛӢ>

# --- Meta (App Secret аз Meta dashboard; Verify Token худатон месозед) ---
WEBHOOKS_APP_SECRET=<ЗАМИНАИ_ХОЛӢ>
WEBHOOKS_VERIFY_TOKEN=<ЗАМИНАИ_ХОЛӢ>
